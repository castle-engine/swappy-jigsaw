<?xml version="1.0" encoding="utf-8"?>
<project name="SwappyJigsaw"
  caption="Swappy Jigsaw"
  qualified_name="net.itch.io.swappyjigsaw"
  standalone_source="SwappyJigsaw.pas"
  game_units="InitUnit"
  screen_orientation="landscape"
  fullscreen_immersive="true"
  author="Yevhen Loza">
  <icons>
    <icon path="SwappyJigsawIcon.ico" />
    <icon path="SwappyJigsawIcon.png" />
  </icons>
  <android>
    <services>
      <service name="ogg_vorbis" />
      <service name="sound" />
      <service name="vibrate" />
    </services>
  </android>
  <dependencies>
    <dependency name="Sound" />
    <dependency name="OggVorbis" />
  </dependencies>
  <compiler_options>
    <search_paths>
      <path value="src/" />
    </search_paths>
  </compiler_options>
</project>
